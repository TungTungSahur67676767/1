
#include <iostream>  // Библиотека ввода и вывода
#include <fstream>   // Библиотека для работы с файлами
#include <windows.h> // Библиотека Windows, нужна для Sleep()

using namespace std; // Используем стандартное пространство имён

// Структура, содержащая информацию о студенте
struct Student
{
    char name[25]; // Фамилия студента
    int grades[5]; // Массив из пяти оценок
} B;                // Создаём объект структуры B

int answer;         // Переменная для хранения размера стипендии
long size_pred;     // Позиция в файле, до которой данные обработаны

int main()
{
    ifstream fR; // Поток для чтения файла запросов
    ofstream fA; // Поток для записи файла ответов

    setlocale(LC_ALL, "rus"); // Поддержка русского языка

    // Пути к файлам обмена данными
    const char* nameR = "C:/REQUEST.bin";
    const char* nameA = "C:/ANSWER.bin";

    cout << "server is working" << endl; // Сообщение о запуске сервера

    // Первоначально открываем файл запросов
    fR.open(nameR, ios::binary);

    fR.seekg(0, ios::end); // Перемещаем указатель в конец файла

    size_pred = fR.tellg(); // Получаем текущую позицию файла

    fR.close(); // Закрываем файл запросов

    // Бесконечный цикл работы сервера
    while (true)
    {
        fR.open(nameR, ios::binary); // Открываем файл запросов

        fR.seekg(0, ios::end); // Переходим в конец файла

        // Ожидаем появления нового запроса
        while (size_pred >= fR.tellg())
        {
            Sleep(100); // Ожидаем 100 миллисекунд

            fR.clear(); // Сбрасываем состояние потока

            fR.seekg(0, ios::end); // Повторно проверяем конец файла
        }

        // Переходим к началу нового запроса
        fR.seekg(size_pred, ios::beg);

        // Считываем данные студента из файла
        fR.read((char*)&B, sizeof(B));

        // Запоминаем позицию после прочитанного запроса
        size_pred = fR.tellg();

        fR.close(); // Закрываем файл запросов

        // Переменные для проверки успеваемости
        bool all_five = true; // Все оценки равны пяти
        bool all_good = true; // Все оценки не ниже четырёх

        // Перебираем все пять оценок
        for (int i = 0; i < 5; i++)
        {
            if (B.grades[i] != 5)
                all_five = false; // Найдена оценка, отличная от пяти

            if (B.grades[i] < 4)
                all_good = false; // Найдена оценка ниже четырёх
        }

        // Определяем размер стипендии
        if (all_five)
            answer = 5000; // Повышенная стипендия

        else if (all_good)
            answer = 3000; // Обычная стипендия

        else
            answer = 0; // Стипендия не назначается

        // Открываем файл ответов в бинарном режиме
        // ios::app позволяет добавлять данные в конец файла
        fA.open(nameA, ios::binary | ios::app);

        // Записываем размер стипендии в файл
        fA.write((char*)&answer, sizeof(answer));

        fA.close(); // Закрываем файл ответов
    }

    return 0; // Завершение программы
}
